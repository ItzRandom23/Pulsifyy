{
	"name": "pulsifyy",
	"version": "0.1.1",
	"description": "A Lavalink v4 client for Discord music bots with autoplay, filters, and session recovery.",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs/*.md"
	],
	"scripts": {
		"build": "node scripts/check.js && npm run typecheck",
		"lint": "eslint . --max-warnings 0",
		"typecheck": "tsc --noEmit",
		"test": "node --test \"test/*.test.js\"",
		"ci": "npm run build && npm run lint && npm test"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"discord.js": "^14.0.0",
		"eslint": "^10.15.0",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@discordjs/collection": "^2.1.1",
		"@types/ws": "^8.18.1",
		"axios": "^1.21.1",
		"parse5": "^8.0.0",
		"tslib": "^2.8.1",
		"ws": "^8.23.0"
	},
	"peerDependencies": {
		"discord.js": ">=13.0.0 <15.0.0"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"keywords": [
		"lavalink",
		"discord",
		"music",
		"audio",
		"pulsify"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ItzRandom23/Pulsify.git"
	},
	"author": "Itz Random",
	"license": "Apache-2.0",
	"homepage": "https://github.com/ItzRandom23/Pulsify#readme",
	"bugs": {
		"url": "https://github.com/ItzRandom23/Pulsify/issues"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"peerDependenciesMeta": {
		"discord.js": {
			"optional": true
		}
	}
}
